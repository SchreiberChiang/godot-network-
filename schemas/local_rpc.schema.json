{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator-owned loopback RPC v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "token",
        "launch_id"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "hello"
        },
        "token": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "launch_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "hello_ok"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "heartbeat"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "id",
        "action",
        "payload"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "request"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{1,63}$"
        },
        "payload": {
          "type": "object",
          "maxProperties": 128
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "id",
        "payload"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "response"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "payload": {
          "type": "object",
          "maxProperties": 128
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "kind",
        "action",
        "payload"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "event"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "payload": {
          "type": "object",
          "maxProperties": 128
        }
      }
    }
  ]
}
