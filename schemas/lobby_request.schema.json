{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M2 local lobby request",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "properties": {
        "kind": {
          "const": "request"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "event_id"
            ]
          },
          {
            "required": [
              "room_id"
            ]
          },
          {
            "required": [
              "launch_id"
            ]
          },
          {
            "required": [
              "game_id"
            ]
          },
          {
            "required": [
              "build_id"
            ]
          }
        ]
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "session.create"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "display_name"
              ],
              "properties": {
                "display_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "room.list"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "game_id",
                "build_id",
                "compatibility_id",
                "game_protocol",
                "offset",
                "limit"
              ],
              "properties": {
                "game_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "build_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "compatibility_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "game_protocol": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "room.create"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "game_id",
                "build_id",
                "compatibility_id",
                "game_protocol",
                "options"
              ],
              "properties": {
                "game_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "build_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "compatibility_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "game_protocol": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "options": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "mode",
                    "map",
                    "capacity"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "map": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "capacity": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 16
                    }
                  }
                }
              }
            }
          },
          "required": [
            "idempotency_key"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "room.get"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "room_id"
              ],
              "properties": {
                "room_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "room.reserve"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "game_id",
                "build_id",
                "compatibility_id",
                "game_protocol",
                "room_id"
              ],
              "properties": {
                "game_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "build_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "compatibility_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "game_protocol": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "room_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "room.stop"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "room_id"
              ],
              "properties": {
                "room_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        }
      ]
    }
  ]
}
