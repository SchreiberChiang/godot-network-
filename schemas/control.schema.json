{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoomKit M1/M2 process control protocol 1",
  "description": "Strict loopback process-control subset; runtime checks authentication, identity and lifecycle. Not the public lobby protocol.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "required": [
        "room_id",
        "launch_id",
        "game_id",
        "build_id"
      ],
      "properties": {
        "kind": {
          "const": "event"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "request_id"
            ]
          },
          {
            "required": [
              "idempotency_key"
            ]
          }
        ]
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "room.register"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "token",
                "pid"
              ],
              "properties": {
                "token": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "pid": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "room.ready"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "udp_port"
              ],
              "properties": {
                "udp_port": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 65535
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "room.heartbeat"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sequence",
                "step"
              ],
              "properties": {
                "sequence": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "step": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "enum": [
                "room.drain",
                "room.stop"
              ]
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "room.stopped"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "room.failed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "PORT_BIND_FAILED",
                    "AUTH_FAILED",
                    "CONTROL_UNAVAILABLE",
                    "INVALID_OPTIONS",
                    "BUILD_MISMATCH"
                  ]
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "admission.consume"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ticket",
                "attempt_id",
                "user_id",
                "compatibility_id",
                "game_protocol"
              ],
              "properties": {
                "ticket": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "attempt_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "user_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "compatibility_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "game_protocol": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "admission.result"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt_id",
                "ok",
                "user_id",
                "display_name",
                "code"
              ],
              "properties": {
                "attempt_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "ok": {
                  "type": "boolean"
                },
                "user_id": {
                  "type": "string",
                  "maxLength": 128
                },
                "display_name": {
                  "type": "string",
                  "maxLength": 32
                },
                "code": {
                  "type": "string",
                  "maxLength": 64
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "admission.revoke"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt_id"
              ],
              "properties": {
                "attempt_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "member.joined"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt_id",
                "user_id"
              ],
              "properties": {
                "attempt_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "user_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "member.left"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt_id",
                "user_id"
              ],
              "properties": {
                "attempt_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "user_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": {
              "const": "member.accepted"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempt_id",
                "ok"
              ],
              "properties": {
                "attempt_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "ok": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
