{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed server-side game manifest v1 (design draft)",
  "description": "Structure only. Deployment must reject placeholders, verify artifact and exact tested versions, validate player limits across fields and maps/modes against the real build.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "game_id",
    "build_id",
    "control_protocol",
    "game_protocol",
    "sdk_version",
    "godot_version",
    "compatibility_id",
    "server_artifact",
    "transport",
    "max_players",
    "modes"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "game_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "build_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "control_protocol": {
      "const": 1
    },
    "game_protocol": {
      "type": "integer",
      "minimum": 1
    },
    "sdk_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "godot_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "compatibility_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "server_artifact": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "transport": {
      "enum": [
        "enet"
      ]
    },
    "max_players": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "modes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{1,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "min_players",
          "max_players",
          "maps",
          "allow_join_in_progress"
        ],
        "properties": {
          "min_players": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "max_players": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "maps": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,63}$"
            }
          },
          "allow_join_in_progress": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
