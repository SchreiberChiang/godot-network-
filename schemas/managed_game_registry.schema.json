{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trusted local managed game registry v1",
  "description": "Operator startup configuration only. No client or HTTP request can supply paths or scripts. Runtime also validates game keys, catalogs and loaded service interfaces.",
  "type": "object",
  "minProperties": 1,
  "maxProperties": 32,
  "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["project", "manifest", "name", "asset_catalog", "asset_policy", "result_schema"],
    "properties": {
      "project": {"$ref": "#/$defs/path"},
      "manifest": {"$ref": "game_manifest.schema.json"},
      "prepared_input_receipt": {"$ref": "#/$defs/prepared_input_receipt"},
      "name": {"type": "string", "minLength": 1, "maxLength": 64},
      "asset_catalog": {"$ref": "#/$defs/path"},
      "asset_policy": {"$ref": "#/$defs/path"},
      "result_schema": {"$ref": "#/$defs/path"},
      "reward_script": {"$ref": "#/$defs/path"},
      "server_executable": {"$ref": "#/$defs/path"},
      "server_pack": {"$ref": "#/$defs/path"},
      "client_executable": {"$ref": "#/$defs/path"},
      "client_pack": {"$ref": "#/$defs/path"}
    }
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\x00-\\x1f\\x7f]+$"},
    "prepared_input_receipt": {
      "description": "Optional local build evidence. Exporters verify the raw-byte digest; the runtime validates its structure and never executes or opens these receipt paths.",
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "algorithm", "sha256", "files"],
      "properties": {
        "format": {"const": 1},
        "algorithm": {"const": "roomkit-prepared-input-v1"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "files": {
          "type": "array", "minItems": 1, "maxItems": 4096,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\x00-\\x1f\\x7f:]+$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  }
}
