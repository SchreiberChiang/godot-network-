{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Permanent asset state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "credits",
    "experience",
    "owned",
    "profiles"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "credits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "experience": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "owned": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,63}$"
      }
    },
    "profiles": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "maxProperties": 16,
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        }
      }
    }
  }
}
