{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed control envelope v1 (design draft)",
  "description": "Only the envelope. Does not validate message-specific payload, authorization, idempotency, size in bytes or state transitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "type",
    "payload"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "request",
        "response",
        "event"
      ]
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 96
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "game_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "build_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "room_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "launch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {
      "type": "object"
    },
    "ok": {
      "type": "boolean"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "request",
              "response"
            ]
          }
        }
      },
      "then": {
        "required": [
          "request_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "event"
          }
        }
      },
      "then": {
        "required": [
          "event_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "response"
          }
        }
      },
      "then": {
        "required": [
          "ok"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "response"
          },
          "ok": {
            "const": false
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "request",
              "event"
            ]
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "ok"
              ]
            },
            {
              "required": [
                "error"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "response"
          },
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ]
}
