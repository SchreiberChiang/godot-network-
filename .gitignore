# Godot generated caches (do not ignore source .uid sidecars)
**/.godot/

# Local runtime state and secrets at repository root
/run/
/data/
/logs/
/artifacts/
/PlayerClient/
.env
.env.*
!.env.example
config/local.*
config/secrets/
*.key
*.pem

# OS/editor noise
.DS_Store
Thumbs.db
*.tmp

# Standalone shooter client: Client.exe (>100 MiB) ships as a GitHub Release
# asset; per-server public connection files are placed by each player.
/clients/*/Client.exe
/clients/*/connection.json
/clients/*/server.crt
/clients/*/server-config/
/clients/*/*.partial
