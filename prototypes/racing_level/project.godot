config_version=5

[application]
config/name="Port Loop | Racing Level Study"
run/main_scene="res://viewer.tscn"

[display]
window/size/viewport_width=1440
window/size/viewport_height=1000
window/size/window_width_override=1200
window/size/window_height_override=834
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.075, 0.14, 0.18, 1)
